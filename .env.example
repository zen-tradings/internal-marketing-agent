# Zen Content Hub 本机配置样例。复制为 .env 后填写真实值，切勿提交 .env。

WORK_DIR=/Users/yourname/zen-wechat-theme
DB_PATH=/Users/yourname/Library/Application Support/zen-content-hub/runs.db

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_ROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_REVIEW_MODEL=z-ai/glm-5.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=12000
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_HTTP_REFERER=https://zentradings.com
OPENROUTER_APP_TITLE=Zen Content Hub

# 结构锁定直译 V2。先在 HUB_DRY_RUN=1 下验收；开启后不会在完整性失败时回退旧链发布。
TRANSLATION_V2_ENABLED=false
TRANSLATION_BROWSER_ENABLED=true
TRANSLATION_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
TRANSLATION_BROWSER_TIMEOUT_MS=45000
TRANSLATION_FETCH_TIMEOUT_MS=30000
TRANSLATION_MAX_SOURCE_BYTES=12582912
TRANSLATION_MAX_ASSET_BYTES=20971520
TRANSLATION_MAX_ASSETS=80
TRANSLATION_MAX_REDIRECTS=5
NOTION_API_TOKEN=
# 可选：复杂/扫描 PDF 的 Docling CLI；留空时继续使用 Poppler 严格路径。
TRANSLATION_DOCLING_PATH=
TRANSLATION_DOCLING_TIMEOUT_MS=180000
TRANSLATION_REMOTE_FALLBACK=none

EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5
EXA_PRIORITY_RESULTS=4
EXA_USER_CONTENT_MAX_CHARS=24000
EXA_TIMEOUT_MS=45000
# 用英文逗号整体覆盖默认优先/官方域名清单；留空时使用 workflows/shared.js 内置清单。
EXA_PRIORITY_DOMAINS=
EXA_OFFICIAL_DOMAINS=

MAX_CONCURRENCY=1
DEFAULT_TIMEOUT_MS=600000

# 固定出口保护：开启后，启动、每个任务和微信发布前都会核对公网 IP。
# 不一致或无法查询时会停止联网，避免 Clash/TUN 掉线后直连。
EGRESS_GUARD_ENABLED=true
# 原有单出口配置继续有效；额外允许出口用英文逗号分隔追加到 EXPECTED_EGRESS_IPS。
EXPECTED_EGRESS_IP=
EXPECTED_EGRESS_IPS=
EGRESS_CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace
EGRESS_CHECK_TIMEOUT_MS=8000
EGRESS_RETRY_MS=10000
EGRESS_MONITOR_INTERVAL_MS=15000
EGRESS_MONITOR_FAILURE_THRESHOLD=2

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
NOTIFY_CHANNEL_ID=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 默认真实渠道；安全演练请优先使用 HUB_DRY_RUN=1，也可改为 mock。
WECHAT_CHANNEL=wechat-draft
WECHAT_HEADER_IMAGE=
WECHAT_FOOTER_IMAGE=

# 可选：设置后自动创建晨报 cron 触发器，例如 0 8 * * 1-5。
MORNING_CRON=

# Customer.io newsletter：默认只创建草稿，不会自动发送。
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_API_BASE_URL=https://api.customer.io
# 分阶段扩容：internal → pilot → full。默认只允许 internal。
NEWSLETTER_AUDIENCE_STAGE=internal
CUSTOMERIO_INTERNAL_SEGMENT_ID=17
CUSTOMERIO_PILOT_SEGMENT_ID=18
CUSTOMERIO_FULL_SEGMENT_ID=6
CUSTOMERIO_INTERNAL_MAX_RECIPIENTS=10
CUSTOMERIO_PILOT_MAX_RECIPIENTS=50
# 可选：full 阶段的额外人数上限；留空时不额外限制。
CUSTOMERIO_FULL_MAX_RECIPIENTS=
# full 阶段必须显式改为 true；创建的仍只是草稿，不会发送或排期。
CUSTOMERIO_ALLOW_FULL_AUDIENCE=false
CUSTOMERIO_SUBSCRIPTION_TOPIC_ID=
CUSTOMERIO_NEWSLETTER_FROM="Zen Trading <support@zentradings.com>"
CUSTOMERIO_COMPANY_ADDRESS=
CUSTOMERIO_SITE_URL=https://zentradings.com
CUSTOMERIO_NEWSLETTER_FEEDBACK_URL=
CUSTOMERIO_NEWSLETTER_HEADER_IMAGE_URL=
CUSTOMERIO_NEWSLETTER_CONTACT_EMAIL=
NEWSLETTER_EDITION="Vol. 1"

# 安全演练时取消下一行注释，发布将改道 mock 渠道。
# HUB_DRY_RUN=1
