# Zen Content Hub 本机配置样例。复制为 .env 后填写真实值，切勿提交 .env。

WORK_DIR=/Users/yourname/zen-wechat-theme
DB_PATH=/Users/yourname/Library/Application Support/zen-content-hub/runs.db

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=12000
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_HTTP_REFERER=https://zentradings.com
OPENROUTER_APP_TITLE=Zen Content Hub

EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5
EXA_PRIORITY_RESULTS=4
EXA_USER_CONTENT_MAX_CHARS=24000
EXA_TIMEOUT_MS=45000

MAX_CONCURRENCY=1
DEFAULT_TIMEOUT_MS=600000

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
NOTIFY_CHANNEL_ID=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CHANNEL=wechat-draft

# Customer.io newsletter：默认只创建草稿，不会自动发送。
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_API_BASE_URL=https://api.customer.io
# 分阶段扩容：internal → pilot → full。默认只允许 internal。
NEWSLETTER_AUDIENCE_STAGE=internal
CUSTOMERIO_INTERNAL_SEGMENT_ID=17
CUSTOMERIO_PILOT_SEGMENT_ID=18
CUSTOMERIO_FULL_SEGMENT_ID=6
CUSTOMERIO_INTERNAL_MAX_RECIPIENTS=10
CUSTOMERIO_PILOT_MAX_RECIPIENTS=50
# full 阶段必须显式改为 true；创建的仍只是草稿，不会发送或排期。
CUSTOMERIO_ALLOW_FULL_AUDIENCE=false
CUSTOMERIO_SUBSCRIPTION_TOPIC_ID=
CUSTOMERIO_NEWSLETTER_FROM=
CUSTOMERIO_COMPANY_ADDRESS=
CUSTOMERIO_SITE_URL=https://zentradings.com
CUSTOMERIO_NEWSLETTER_FEEDBACK_URL=
NEWSLETTER_EDITION="Vol. 1"

# 安全演练时取消下一行注释，发布将改道 mock 渠道。
# HUB_DRY_RUN=1
