# Zen Content Hub 本机配置样例。复制为 .env 后填写真实值，切勿提交 .env。

WORK_DIR=/Users/yourname/zen-wechat-theme
DB_PATH=/Users/yourname/Library/Application Support/zen-content-hub/runs.db

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-max
OPENROUTER_ROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_PLANNER_MODEL=moonshotai/kimi-k3
OPENROUTER_REVIEW_MODEL=z-ai/glm-5.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=12000
OPENROUTER_MAX_PROMPT_CHARS=160000
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_PLANNER_REASONING_EFFORT=high
OPENROUTER_REVIEW_REASONING_EFFORT=none
OPENROUTER_ROUTER_REASONING_EFFORT=none
OPENROUTER_HTTP_REFERER=https://zentradings.com
OPENROUTER_APP_TITLE=Zen Content Hub

# 微信分析链路 V2：Slack 原始 Prompt 最高优先，规划/证据/局部审计与正文写作分离。
# v1 仅作为单实例紧急回退；禁止同时运行 V1/V2 两个实例。
ANALYSIS_PIPELINE_VERSION=v2
ANALYSIS_SEARCH_MAX_QUERIES=8
ANALYSIS_RECENT_WINDOW_DAYS=60

# 直译优先读取原站结构化 HTML；PDF 使用 Datalab 托管解析并保留标题、段落、图片、图注、表格和公式。
TRANSLATION_BROWSER_ENABLED=true
TRANSLATION_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
TRANSLATION_BROWSER_TIMEOUT_MS=45000
TRANSLATION_FETCH_TIMEOUT_MS=30000
TRANSLATION_MAX_SOURCE_BYTES=52428800
TRANSLATION_MAX_PDF_PAGES=120
TRANSLATION_MAX_REDIRECTS=5
TRANSLATION_MAX_ASSET_COUNT=80
TRANSLATION_MAX_ASSET_BYTES=41943040
TRANSLATION_MAX_SINGLE_ASSET_BYTES=10485760
NOTION_API_TOKEN=
# 推荐：Google Drive OAuth 只读 refresh token，用于长期读取授权账号可见的私有 Google Docs。
# 在 Google Cloud 创建“桌面应用”OAuth client，填入 client id/secret 后运行 npm run auth:google-docs。
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_DOCS_REFRESH_TOKEN=
# 兼容旧配置：临时 access token。会过期，仅在没有配置上述 refresh token 组合时使用。
GOOGLE_DOCS_ACCESS_TOKEN=
# 可选：读取私有 GitHub 仓库或提高 GitHub API 限额；只授予 contents:read。
GITHUB_TOKEN=
DATALAB_API_KEY=
DATALAB_API_BASE_URL=https://www.datalab.to/api/v1
DATALAB_MODE=balanced
DATALAB_TIMEOUT_MS=300000
DATALAB_POLL_INTERVAL_MS=2000

# 封面生成器默认使用仓库内置 tools/cover-generator；仅自定义实现时覆盖目录。
COVER_GENERATOR_DIR=

# 写作任务文章配图(AntV Infographic 本地渲染 + Playwright 截图);直译任务始终跳过
INFOGRAPHIC_ENABLED=true
INFOGRAPHIC_MAX_IMAGES=2
INFOGRAPHIC_TIMEOUT_MS=45000
INFOGRAPHIC_PROCESS_TIMEOUT_MS=90000
INFOGRAPHIC_GENERATOR_DIR=
# 留空时复用 TRANSLATION_BROWSER_EXECUTABLE，再自动发现常见 Chromium/Chrome 路径。
COVER_BROWSER_EXECUTABLE=
COVER_REQUEST_TIMEOUT_MS=30000
COVER_PROCESS_TIMEOUT_MS=90000

EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5
EXA_PRIORITY_RESULTS=4
EXA_USER_CONTENT_MAX_CHARS=24000
EXA_TIMEOUT_MS=45000
# 用英文逗号整体覆盖默认优先/官方域名清单；留空时使用 workflows/shared.js 内置清单。
EXA_PRIORITY_DOMAINS=
EXA_OFFICIAL_DOMAINS=
# 用英文逗号扩展内置名单，不会覆盖默认值。前者用于剔除政府资助、国家所有或公共广播媒体；
# 后者用于把额外的独立第三方报道/研究域名纳入同层级优先排序。
EXA_EXCLUDED_MEDIA_DOMAINS=
EXA_INDEPENDENT_MEDIA_DOMAINS=

MAX_CONCURRENCY=1
MAX_QUEUE_SIZE=100
DEFAULT_TIMEOUT_MS=600000
RUN_RETENTION_DAYS=90
SLACK_THREAD_RETENTION_DAYS=30

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Slack App 的 Bot Token Scopes 必须含 files:read；新增 scope 后需重新安装 App。
NOTIFY_CHANNEL_ID=
# 生产环境必须填写允许使用 Bot 的 Slack user ID/channel ID；逗号分隔。本机留空表示不限制。
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_RATE_LIMIT_PER_MINUTE=10
# 新消息或最后一次编辑静默多久后入队；编辑/线程补充会替换尚未发布的旧修订。
SLACK_EDIT_DEBOUNCE_MS=5000

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 默认真实渠道；安全演练请优先使用 HUB_DRY_RUN=1，也可改为 mock。
WECHAT_CHANNEL=wechat-draft
WECHAT_HEADER_IMAGE=
WECHAT_SURVEY_IMAGE=
WECHAT_FOOTER_IMAGE=

# 可选：设置后自动创建晨报 cron 触发器，例如 0 8 * * 1-5。
MORNING_CRON=
CRON_TIMEZONE=America/Los_Angeles

# 可选健康检查；0 表示关闭。云服务器建议仅监听 127.0.0.1。
HEALTH_HOST=127.0.0.1
HEALTH_PORT=0

# Customer.io newsletter：默认只创建草稿，不会自动发送。
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_API_BASE_URL=https://api.customer.io
CUSTOMERIO_TIMEOUT_MS=30000
# 分阶段扩容：internal → pilot → full。默认只允许 internal。
NEWSLETTER_AUDIENCE_STAGE=internal
CUSTOMERIO_INTERNAL_SEGMENT_ID=17
CUSTOMERIO_PILOT_SEGMENT_ID=18
CUSTOMERIO_FULL_SEGMENT_ID=6
CUSTOMERIO_INTERNAL_MAX_RECIPIENTS=10
CUSTOMERIO_PILOT_MAX_RECIPIENTS=50
# 可选：full 阶段的额外人数上限；留空时不额外限制。
CUSTOMERIO_FULL_MAX_RECIPIENTS=
# full 阶段必须显式改为 true；创建的仍只是草稿，不会发送或排期。
CUSTOMERIO_ALLOW_FULL_AUDIENCE=false
CUSTOMERIO_SUBSCRIPTION_TOPIC_ID=
CUSTOMERIO_NEWSLETTER_FROM="Zen Trading <support@zentradings.com>"
CUSTOMERIO_COMPANY_ADDRESS=
CUSTOMERIO_SITE_URL=https://zentradings.com
CUSTOMERIO_NEWSLETTER_FEEDBACK_URL=
CUSTOMERIO_NEWSLETTER_HEADER_IMAGE_URL=
CUSTOMERIO_NEWSLETTER_CONTACT_EMAIL=
NEWSLETTER_EDITION="Vol. 1"

# Zen Opening Digest：测试阶段独立发送到 test2。启用前必须已取得 OIC/iVolatility
# 对自动访问、截图和内部邮件分发的书面授权，并在 DigitalOcean 上建立受保护的浏览器状态文件。
# 表格最终用同会话 DOM 数据渲染为响应式 HTML；截图只作一致性校验并立即丢弃，EOD cache 只保存 JSON 数据。
OPENING_DIGEST_ENABLED=false
OPENING_DIGEST_TIMEZONE=America/New_York
OIC_AUTOMATION_AUTHORIZED=false
OIC_TRENDING_OPTIONS_URL=https://www.optionseducation.org/toolsoptionquotes/trending-options-volume
OIC_STORAGE_STATE_PATH=/etc/zen-content-hub/oic-storage-state.json
OIC_CAPTURE_TIMEOUT_MS=45000
OPENING_DIGEST_BROWSER_EXECUTABLE=/usr/bin/google-chrome
CUSTOMERIO_OPENING_DIGEST_SEGMENT_ID=
CUSTOMERIO_OPENING_DIGEST_TOPIC_ID=
CUSTOMERIO_OPENING_DIGEST_ASSET_FOLDER_ID=
OPENING_DIGEST_EOD_CACHE_PATH=/var/lib/zen-content-hub/work/opening-digest-options-eod.json

# 安全演练时取消下一行注释，发布将改道 mock 渠道。
# HUB_DRY_RUN=1
