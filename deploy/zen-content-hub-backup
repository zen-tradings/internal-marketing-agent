#!/bin/sh
set -eu

data_dir=/var/lib/zen-content-hub
backup_dir="$data_dir/backups"
database="$data_dir/runs.db"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary="$backup_dir/.runs-$stamp.db.tmp"
snapshot="$backup_dir/runs-$stamp.db"

install -d -o zenbot -g zenbot -m 0700 "$backup_dir"
/usr/bin/sqlite3 "$database" ".timeout 5000" ".backup '$temporary'"
chmod 0600 "$temporary"
mv "$temporary" "$snapshot"

# 同盘快照保留 14 天；Droplet 灾难恢复仍需独立的异地备份。
find "$backup_dir" -maxdepth 1 -type f -name 'runs-*.db' -mtime +14 -delete

