[Unit]
Description=Build the sanitized Zen Content Hub MCP read model
After=zen-content-hub.service

[Service]
Type=oneshot
User=zenbot
Group=zenmcp
WorkingDirectory=/opt/zen-content-hub
Environment=NODE_ENV=production
EnvironmentFile=/etc/zen-content-hub/zen-content-hub-mcp-export.env
ExecStart=/usr/bin/node scripts/build-mcp-read-model.mjs
UMask=0027
Nice=10
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/zen-content-hub/runs.db
ReadWritePaths=/var/lib/zen-content-hub-mcp
InaccessiblePaths=-/var/lib/zen-content-hub/work -/var/lib/zen-content-hub/backups -/etc/zen-content-hub/zen-content-hub.env -/etc/zen-content-hub/oic-storage-state.json
RestrictAddressFamilies=AF_UNIX
