# Zen Content Hub — 部署环境变量样例（不含真实值，复制为 .env 并填写）
# 用法：cp deploy/.env.example /srv/zen/app/.env 然后填入真实值，权限建议 chmod 600 .env

# ---- 运行路径 ----
WORK_DIR=/srv/zen/wechat
DB_PATH=/srv/zen/runs.db

# ---- 写作内核:OpenRouter 开源模型(替代 Claude Code,见 docs/HANDOFF.md §7)----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-235b-a22b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_HTTP_REFERER=https://zentradings.com
OPENROUTER_APP_TITLE=Zen Content Hub
# 调研用 Exa(服务端 REST/SDK,非 MCP)
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5

# ---- 并发/超时 ----
MAX_CONCURRENCY=1
DEFAULT_TIMEOUT_MS=600000

# ---- 代理 ----
# 海外 VPS 当前部署目标要求 OpenRouter/Exa/微信 全部直连。
# 不要设置 https_proxy/http_proxy/all_proxy,否则 src/index.js 会拒绝启动。

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
NOTIFY_CHANNEL_ID=

# ---- 微信公众号 ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- 发布渠道 ----
# wechat 工作流实际使用的渠道,默认 wechat-draft(真实发布到微信草稿箱)。
# 本地/演练环境想避免真的发草稿,可设为 mock,或直接设 HUB_DRY_RUN=1
# (HUB_DRY_RUN 优先级更高,不管 WECHAT_CHANNEL 是什么都会强制走 mock)。
WECHAT_CHANNEL=wechat-draft
# HUB_DRY_RUN=1
