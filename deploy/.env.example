# Zen Content Hub — 部署环境变量样例（不含真实值，复制为 .env 并填写）
# 用法：cp deploy/.env.example /srv/zen/app/.env 然后填入真实值，权限建议 chmod 600 .env

# ---- 运行路径 ----
WORK_DIR=/srv/zen/wechat
DB_PATH=/srv/zen/runs.db
# CLAUDE_BIN 仅旧 Claude Code runner 用;OpenRouter runner 上线后作废(见 docs/HANDOFF.md §7)
CLAUDE_BIN=/root/.local/bin/claude

# ---- 写作内核:OpenRouter 开源模型(替代 Claude Code,见 docs/HANDOFF.md §7)----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-235b-a22b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 调研用 Exa(服务端 REST/SDK,非 MCP)
EXA_API_KEY=

# ---- 并发/超时 ----
MAX_CONCURRENCY=1
DEFAULT_TIMEOUT_MS=600000

# ---- 代理 ----
# 海外 VPS(当前部署目标):OpenRouter/Exa/微信 均可直连,通常无需任何代理,下面 CHILD_* 留空即可。
# 仅国内 VPS 才需要:CHILD_* 给写作/调研出海用,微信仍走 NO_PROXY 直连。
# 主进程严禁设置 https_proxy/http_proxy/all_proxy(src/index.js assertMainProcessDirect() 强制校验)。
CHILD_HTTPS_PROXY=
CHILD_ALL_PROXY=
NO_PROXY=api.weixin.qq.com,mp.weixin.qq.com

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
NOTIFY_CHANNEL_ID=

# ---- 微信公众号 ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- 发布渠道 ----
# wechat 工作流实际使用的渠道,默认 wechat-draft(真实发布到微信草稿箱)。
# 本地/演练环境想避免真的发草稿,可设为 mock,或直接设 HUB_DRY_RUN=1
# (HUB_DRY_RUN 优先级更高,不管 WECHAT_CHANNEL 是什么都会强制走 mock)。
WECHAT_CHANNEL=wechat-draft
# HUB_DRY_RUN=1
