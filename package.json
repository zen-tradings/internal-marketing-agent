{
  "name": "zen-content-hub",
  "version": "2.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "check:openrouter": "node scripts/check-openrouter.mjs",
    "check:translation": "node scripts/check-translation.mjs",
    "requeue:translation": "node scripts/requeue-translation.mjs",
    "requeue:analysis-gate": "node scripts/requeue-analysis-gate.mjs",
    "check:documents": "node scripts/check-documents.mjs",
    "auth:google-docs": "node scripts/google-docs-oauth.mjs",
    "check:customerio": "node scripts/check-customerio.mjs",
    "check:egress": "node scripts/check-egress.mjs",
    "preview:newsletter": "node scripts/preview-newsletter.mjs",
    "status": "node scripts/status.mjs",
    "trace:research": "node scripts/research-trace.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:dependencies": "npm audit --omit=dev --audit-level=high",
    "check": "npm run check:syntax && npm test && npm run check:dependencies",
    "test": "node --test test/*.test.js test/golden/*.test.js",
    "test:update-golden": "node scripts/update-render-golden.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@slack/bolt": "^3.17.0",
    "@wenyan-md/core": "3.0.11",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.3.1",
    "form-data-encoder": "4.1.0",
    "formdata-node": "6.0.3",
    "jsdom": "27.4.0",
    "node-cron": "^4.6.0",
    "playwright-core": "^1.61.1"
  },
  "overrides": {
    "mermaid": "11.16.0"
  }
}
